# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/app.sqlite

# Public base URL of this worker, used to build the Twilio webhook URL.
# Must be https and reachable from Twilio. In local dev use an ngrok URL.
PUBLIC_BASE_URL=https://your-worker.example.com

# Shared secret protecting the dashboard API (/api/*). Any random string.
# The web UI sends it as `x-api-token`.
DASHBOARD_API_TOKEN=change-me-to-a-long-random-string

# --- Anthropic (writes the alert texts + answers your questions) ---
ANTHROPIC_API_KEY=sk-ant-...
# Alert texts are short and high-volume; Q&A is the one that needs to think.
# Set either to claude-sonnet-5 to trade some quality for cost.
ALERT_MODEL=claude-opus-5
CHAT_MODEL=claude-opus-5
# Effort controls thinking depth/spend without changing the model.
ALERT_EFFORT=low
CHAT_EFFORT=high

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox sender is whatsapp:+14155238886. Swap for your own sender when approved.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your personal number, E.164, with the whatsapp: prefix.
ALERT_RECIPIENT=whatsapp:+15551234567
# Verify inbound webhook signatures. Keep true in production.
TWILIO_VALIDATE_SIGNATURE=true
# Approved template SID (HX...) used to re-open the 24h session window.
# See README "The 24-hour window" — without this, alerts sent when you have not
# messaged the bot in 24h will be rejected by WhatsApp.
TWILIO_ALERT_TEMPLATE_SID=

# --- Financial data providers ---
# Tried in this order; the first one that answers a given call wins. sec-xbrl is
# free and needs no key, so leave it last as a permanent safety net.
FINANCIALS_PROVIDERS=fiscalai,fmp,sec-xbrl

# Fiscal.ai (formerly FinChat). Best historical fundamentals + segment/KPI data.
# NOTE: the REST paths in enrich/fiscalai.ts are inferred, not verified against
# their docs — see the comment at the top of that file before enabling.
FISCALAI_API_KEY=
FISCALAI_BASE_URL=https://api.fiscal.ai
# Optional shorthand: Fiscal.ai's MCP server URL (merged into MCP_SERVERS below).
FISCALAI_MCP_URL=

# --- MCP servers for the chat agent ---
# Anthropic connects to these server-side and runs their tools, so the agent
# gains their capabilities with zero adapter code. JSON array of {name,url,token}.
# `name` must be unique; `token` is optional and sent as the bearer token.
#
# Example — FMP transcripts via MCP bundle:
# MCP_SERVERS=[{"name":"fmp-transcripts","url":"https://mcp.mcpbundles.com/bundle/fmp-transcripts"}]
MCP_SERVERS=

# Financial Modeling Prep (market cap, historical financials, execs, insiders)
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# --- SEC EDGAR (free, no key; used for filings + XBRL fallback financials) ---
# SEC requires a descriptive UA with contact info or they will 403 you.
SEC_USER_AGENT=News-for-Stocks/0.1 (you@example.com)

# --- Scanning ---
# How often to poll every source, in seconds.
SCAN_INTERVAL_SECONDS=300
# Ignore anything published more than this many hours ago on first sight.
MAX_ITEM_AGE_HOURS=24
# Hard cap on alerts sent per hour, so a noisy keyword cannot spam you.
MAX_ALERTS_PER_HOUR=12
# Set true to run the scan loop without sending any WhatsApp messages.
DRY_RUN=false
