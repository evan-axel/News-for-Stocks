# Copy to .env and fill in. .env is gitignored.

# --- SEC filings (/research) ---------------------------------------------
# REQUIRED to fetch anything from EDGAR. SEC requires every automated client to
# declare itself with a real contact address, and blocks those that don't.
# Format: "Name email@domain.com"
SEC_USER_AGENT=

# --- Summaries and chat ---------------------------------------------------
# Needed for filing summaries and the Ask panel. Filing search and reading the
# document text work without it. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- News scanner (/scanner) ----------------------------------------------
ALPHA_VANTAGE_API_KEY=
